# OpenSSL settings for libimobiledevice's tools against iOS 6's lockdownd (OPENSSL_CONF=this file):
# its TLS lacks RFC 5746 secure renegotiation and signs with SHA-1, which OpenSSL 3 refuses by default.
openssl_conf = openssl_init
[openssl_init]
ssl_conf = ssl_sect
[ssl_sect]
system_default = system_default_sect
[system_default_sect]
MinProtocol = TLSv1
CipherString = DEFAULT@SECLEVEL=0
Options = UnsafeLegacyServerConnect
